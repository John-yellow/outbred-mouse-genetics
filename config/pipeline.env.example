ALIGN_DIR=results/aligned
MARKED_DIR=results/marked
CALL_DIR=results/calling
FILTER_DIR=results/filtered
ANNOTATION_DIR=results/annotated
RELEASE_DIR=release_staging

BWA_MEM2=bwa-mem2
SAMTOOLS=samtools
FAST_DUP=fastdup
BCFTOOLS=bcftools
